# ==============================
# ThiranNexus LabSense - Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==============================

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=labsense_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Device / ESP32 authentication (used from Phase 3 onward)
# This is NOT user login - it's a shared secret so only the ESP32 device
# can POST RFID/sensor events to the backend.
DEVICE_API_KEY=dev-local-testing-key-change-me

# Colour sensor threshold (Phase 5) - RGB target that represents the
# "colour changed, ask teacher to verify" observation, plus a tolerance.
# A reading counts as a match if it falls within COLOUR_TOLERANCE of the
# target on all three channels (Euclidean distance).
COLOUR_TARGET_R=255
COLOUR_TARGET_G=105
COLOUR_TARGET_B=180
COLOUR_TOLERANCE=30
